---
import BaseLayout from '../../../components/Layout/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { getTranslations } from '../../../i18n';

const { lang } = Astro.params;
const locale = lang || 'ru';
const t = getTranslations(locale as 'ru' | 'en');
const allBrands = await getCollection('brand', ({ data }) => data.lang === locale);
---

<BaseLayout 
	title={t.pages.brands?.title || (locale === 'ru' ? 'Бренды - FurnituraHub' : 'Brands - FurnituraHub')} 
	locale={locale}
>
	<div class="px-4 lg:px-8 lg:pl-[18.5rem] py-8">
		<h1 class="text-3xl lg:text-4xl font-bold text-white mb-8">
			{lang === 'ru' ? 'Бренды' : 'Brands'}
		</h1>
		
		<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
			{allBrands.map((brand) => {
				const brandSlug = brand.id.split('/')[0];
				return (
					<a
						href={lang === 'ru' ? `/brands/${brandSlug}` : `/${lang}/brands/${brandSlug}`}
						class="bg-block rounded-xl p-6 hover:bg-dark transition-all hover:scale-105 active:scale-95 border border-gray-800"
					>
						<div class="flex items-center gap-4 mb-4">
							<div class="w-16 h-16 flex-shrink-0 bg-gray-700 rounded-lg flex items-center justify-center overflow-hidden">
								{brand.data.logo ? (
									<img 
										src={brand.data.logo} 
										alt={brand.data.title}
										class="w-full h-full object-contain p-2"
									/>
								) : (
									<span class="text-2xl font-semibold text-gray-400">{brand.data.title.charAt(0)}</span>
								)}
							</div>
							<div>
								<h2 class="text-xl font-bold text-white mb-1">{brand.data.title}</h2>
								{brand.data.website && (
									<p class="text-sm text-gray-400 truncate max-w-[200px]">{brand.data.website}</p>
								)}
							</div>
						</div>
						<p class="text-gray-300 text-sm leading-relaxed">{brand.data.description}</p>
					</a>
				);
			})}
		</div>
	</div>
</BaseLayout>

