---
import BaseLayout from '../../../components/Layout/BaseLayout.astro';
import CommentSection from '../../../components/Comments/CommentSection';
import { getCollection } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';

export async function getStaticPaths() {
	const posts = await getCollection('posts');
	
	// Generate paths for posts without subcategory (deduplicated across languages)
	const pathsSet = new Set<string>();
	
	posts
		.filter(post => !post.data.subcategory)
		.forEach(post => {
			if (post.data.category) {
				const slugParts = post.slug.split('/');
				const filename = slugParts[slugParts.length - 1];
				pathsSet.add(filename);
			} else {
				pathsSet.add(post.slug);
			}
		});
	
	return Array.from(pathsSet).map(slug => ({
		params: { slug }
	}));
}

// Get parameters from route
const { lang, slug } = Astro.params;
const locale = lang || 'ru';

// Find the post based on slug and locale
const allPosts = await getCollection('posts');
const post = allPosts.find(p => {
	if (p.data.subcategory || p.data.lang !== locale) {
		return false;
	}
	if (p.data.category) {
		const slugParts = p.slug.split('/');
		const filename = slugParts[slugParts.length - 1];
		return filename === slug;
	}
	return p.slug === slug;
});

if (!post) {
	return Astro.redirect('/404');
}

const { Content } = await post.render();

// Build back link
const prefix = locale === 'ru' ? '' : '/en';
let backLink = `${prefix}/category/${post.data.category}`;
if (!post.data.category) {
	backLink = prefix || '/';
}

const formattedDate = new Date(post.data.date).toLocaleDateString(
	locale === 'ru' ? 'ru-RU' : 'en-US',
	{
		day: '2-digit',
		month: 'long',
		year: 'numeric',
	}
);

// Find corresponding post in other language
let languageSwitchUrl: string | undefined;
try {
	const otherLang = lang === 'ru' ? 'en' : 'ru';
	const allPosts = await getCollection('posts');
	
	// Extract base name from current post slug (e.g., "post-1-en" -> "post-1")
	const currentSlugParts = post.slug.split('/');
	const currentFilename = currentSlugParts[currentSlugParts.length - 1];
	const baseName = currentFilename.replace(/-(en|ru)$/, '');
	
	// Find post with same category and base name but different language (no subcategory)
	const correspondingPost = allPosts.find(p => {
		if (p.data.lang !== otherLang || p.data.category !== post.data.category || p.data.subcategory) {
			return false;
		}
		const pSlugParts = p.slug.split('/');
		const pFilename = pSlugParts[pSlugParts.length - 1];
		const pBaseName = pFilename.replace(/-(en|ru)$/, '');
		return pBaseName === baseName;
	});
	
	if (correspondingPost) {
		const slugParts = correspondingPost.slug.split('/');
		const filename = slugParts[slugParts.length - 1];
		if (otherLang === 'en') {
			languageSwitchUrl = `/en/posts/${filename}`;
		} else {
			languageSwitchUrl = `/posts/${filename}`;
		}
	}
} catch (err) {
	// If we can't find corresponding post, languageSwitchUrl will be undefined
	// and Header will use default logic
}

// Tag colors mapping
const tagColors: Record<string, string> = {
	'РЕДАКЦИЯ': 'bg-blue-500/20 text-blue-400 border-blue-500/30',
	'ГАЙДЫ': 'bg-purple-500/20 text-purple-400 border-purple-500/30',
	'НОВОСТИ': 'bg-green-500/20 text-green-400 border-green-500/30',
	'ОБЗОРЫ': 'bg-orange-500/20 text-orange-400 border-orange-500/30',
};
---

<BaseLayout 
	title={post.data.seoTitle || post.data.title} 
	lang={lang} 
	languageSwitchUrl={languageSwitchUrl}
	bgImagesPost={post.data.bgImagesPost}
>
	<div class="px-4 lg:px-8 lg:pl-[18.5rem] py-6 lg:py-12 max-w-4xl mx-auto">
		<!-- Back Button -->
		<a 
			href={backLink}
			class="inline-flex items-center gap-2 text-gray-400 hover:text-white transition-colors mb-6 lg:mb-8 text-sm lg:text-base"
		>
			<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
			</svg>
			{lang === 'ru' ? 'Назад к категории' : 'Back to category'}
		</a>

		<!-- Article Header -->
		<header class="mb-6 lg:mb-8">
			<div class="flex flex-wrap gap-2 mb-4">
				{post.data.tags.map((tag) => {
					const tagUpper = tag.toUpperCase();
					const colorClass = tagColors[tagUpper] || 'bg-gray-700/30 text-gray-300 border-gray-600/30';
					return (
						<span class={`px-2.5 py-1 text-xs font-medium rounded border ${colorClass}`}>
							{tagUpper}
						</span>
					);
				})}
			</div>

			<h1 class="text-2xl lg:text-4xl font-bold text-white mb-4 leading-tight">
				{post.data.title}
			</h1>

			<div class="flex flex-wrap items-center gap-4 text-sm text-gray-400 mb-4">
				<span class="flex items-center gap-2">
					<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
					</svg>
					{post.data.author}
				</span>
				<span class="flex items-center gap-2">
					<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
					</svg>
					{formattedDate}
				</span>
				{post.data.vesden && (
					<span class="flex items-center gap-2">
						<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3" />
						</svg>
						{lang === 'ru' ? 'Вес дверного полотна' : 'Door leaf weight'}: {post.data.vesden} кг
					</span>
				)}
				{post.data.thickness && (
					<span class="flex items-center gap-2">
						<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
						</svg>
						{lang === 'ru' ? 'Толщина' : 'Thickness'}: {post.data.thickness} мм
					</span>
				)}
			</div>

			{post.data.description && (
				<p class="text-lg text-gray-300 leading-relaxed">
					{post.data.description}
				</p>
			)}
		</header>

		<!-- Article Content -->
		<article class="prose prose-invert prose-lg max-w-none">
			<div class="bg-block rounded-xl p-6 lg:p-8 border border-gray-800">
				<Content />
			</div>
		</article>
	</div>
</BaseLayout>

<style>
	.prose {
		color: rgb(209 213 219);
	}
	
	.prose h1,
	.prose h2,
	.prose h3,
	.prose h4,
	.prose h5,
	.prose h6 {
		color: rgb(255 255 255);
		font-weight: 700;
		margin-top: 2em;
		margin-bottom: 1em;
	}
	
	.prose h2 {
		font-size: 1.875rem;
		line-height: 2.25rem;
	}
	
	.prose h3 {
		font-size: 1.5rem;
		line-height: 2rem;
	}
	
	.prose p {
		margin-top: 1.25em;
		margin-bottom: 1.25em;
		line-height: 1.75;
	}
	
	.prose ul,
	.prose ol {
		margin-top: 1.25em;
		margin-bottom: 1.25em;
		padding-left: 1.625em;
	}
	
	.prose li {
		margin-top: 0.5em;
		margin-bottom: 0.5em;
	}
	
	.prose strong {
		color: rgb(255 255 255);
		font-weight: 600;
	}
	
	.prose a {
		color: rgb(39 110 241);
		text-decoration: underline;
		text-underline-offset: 2px;
	}
	
	.prose a:hover {
		color: rgb(96 165 250);
	}
	
	.prose code {
		color: rgb(255 255 255);
		background-color: rgb(27 27 27);
		padding: 0.125rem 0.375rem;
		border-radius: 0.25rem;
		font-size: 0.875em;
	}
	
	.prose pre {
		background-color: rgb(27 27 27);
		border: 1px solid rgb(31 41 55);
		border-radius: 0.75rem;
		padding: 1rem;
		overflow-x: auto;
		margin-top: 1.5em;
		margin-bottom: 1.5em;
	}
	
	.prose pre code {
		background-color: transparent;
		padding: 0;
	}
</style>

<!-- Comments Section -->
<div class="px-4 lg:px-8 lg:pl-[18.5rem] pb-12 mt-12">
	<div class="max-w-4xl">
		<CommentSection 
			client:load
			postSlug={post.slug}
			locale={locale}
		/>
	</div>
</div>
