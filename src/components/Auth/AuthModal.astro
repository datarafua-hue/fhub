---
// Auth Modal Component
// Handles login, signup, magic link, and Google OAuth
---

<div id="auth-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/70 backdrop-blur-md">
  <div class="bg-bg-block rounded-2xl shadow-2xl w-full max-w-md mx-4 overflow-hidden border border-gray-700">
    <!-- Header -->
    <div class="flex items-center justify-between p-6 border-b border-gray-700">
      <h2 id="auth-modal-title" class="text-2xl font-semibold text-white">
        Вход в аккаунт
      </h2>
      <button
        id="close-auth-modal"
        class="text-gray-400 hover:text-white transition-colors"
        aria-label="Закрыть"
      >
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Tabs -->
    <div class="flex border-b border-gray-700">
      <button
        id="tab-signin"
        class="flex-1 py-3 text-center font-medium transition-colors border-b-2 border-accent-blue text-accent-blue"
        data-tab="signin"
      >
        Вход
      </button>
      <button
        id="tab-signup"
        class="flex-1 py-3 text-center font-medium transition-colors border-b-2 border-transparent text-gray-400 hover:text-white"
        data-tab="signup"
      >
        Регистрация
      </button>
    </div>

    <!-- Content -->
    <div class="p-6">
      <!-- Sign In Form -->
      <form id="signin-form" class="space-y-4">
        <div>
          <label for="signin-email" class="block text-sm font-medium text-gray-300 mb-1">
            Email
          </label>
          <input
            type="email"
            id="signin-email"
            required
            class="w-full px-4 py-3 rounded-lg border border-gray-600 bg-bg-dark text-white placeholder-gray-500 focus:ring-2 focus:ring-accent-blue focus:border-accent-blue transition-all"
            placeholder="your@email.com"
          />
        </div>
        <div>
          <label for="signin-password" class="block text-sm font-medium text-gray-300 mb-1">
            Пароль
          </label>
          <input
            type="password"
            id="signin-password"
            required
            class="w-full px-4 py-3 rounded-lg border border-gray-600 bg-bg-dark text-white placeholder-gray-500 focus:ring-2 focus:ring-accent-blue focus:border-accent-blue transition-all"
            placeholder="••••••••"
          />
        </div>
        <div id="signin-error" class="hidden text-sm text-red-400 bg-red-900/20 p-3 rounded-lg"></div>
        <button
          type="submit"
          class="w-full py-3 bg-accent-blue text-white rounded-lg font-medium hover:bg-blue-600 transition-colors shadow-lg shadow-accent-blue/20"
        >
          Войти
        </button>
        <button
          type="button"
          id="magic-link-btn"
          class="w-full py-3 bg-gray-700 text-white rounded-lg font-medium hover:bg-gray-600 transition-colors"
        >
          Отправить Magic Link
        </button>
      </form>

      <!-- Sign Up Form -->
      <form id="signup-form" class="space-y-4 hidden">
        <div>
          <label for="signup-username" class="block text-sm font-medium text-gray-300 mb-1">
            Имя пользователя
          </label>
          <input
            type="text"
            id="signup-username"
            required
            class="w-full px-4 py-3 rounded-lg border border-gray-600 bg-bg-dark text-white placeholder-gray-500 focus:ring-2 focus:ring-accent-blue focus:border-accent-blue transition-all"
            placeholder="username"
          />
        </div>
        <div>
          <label for="signup-fullname" class="block text-sm font-medium text-gray-300 mb-1">
            Полное имя (необязательно)
          </label>
          <input
            type="text"
            id="signup-fullname"
            class="w-full px-4 py-3 rounded-lg border border-gray-600 bg-bg-dark text-white placeholder-gray-500 focus:ring-2 focus:ring-accent-blue focus:border-accent-blue transition-all"
            placeholder="Иван Иванов"
          />
        </div>
        <div>
          <label for="signup-email" class="block text-sm font-medium text-gray-300 mb-1">
            Email
          </label>
          <input
            type="email"
            id="signup-email"
            required
            class="w-full px-4 py-3 rounded-lg border border-gray-600 bg-bg-dark text-white placeholder-gray-500 focus:ring-2 focus:ring-accent-blue focus:border-accent-blue transition-all"
            placeholder="your@email.com"
          />
        </div>
        <div>
          <label for="signup-password" class="block text-sm font-medium text-gray-300 mb-1">
            Пароль
          </label>
          <input
            type="password"
            id="signup-password"
            required
            minlength="6"
            class="w-full px-4 py-3 rounded-lg border border-gray-600 bg-bg-dark text-white placeholder-gray-500 focus:ring-2 focus:ring-accent-blue focus:border-accent-blue transition-all"
            placeholder="••••••••"
          />
          <p class="mt-1 text-xs text-gray-400">Минимум 6 символов</p>
        </div>
        <div id="signup-error" class="hidden text-sm text-red-400 bg-red-900/20 p-3 rounded-lg"></div>
        <div id="signup-success" class="hidden text-sm text-green-400 bg-green-900/20 p-3 rounded-lg"></div>
        <button
          type="submit"
          class="w-full py-3 bg-accent-blue text-white rounded-lg font-medium hover:bg-blue-600 transition-colors shadow-lg shadow-accent-blue/20"
        >
          Зарегистрироваться
        </button>
      </form>

      <!-- Divider -->
      <div class="relative my-6">
        <div class="absolute inset-0 flex items-center">
          <div class="w-full border-t border-gray-700"></div>
        </div>
        <div class="relative flex justify-center text-sm">
          <span class="px-2 bg-bg-block text-gray-400">или</span>
        </div>
      </div>

      <!-- OAuth Buttons -->
      <button
        id="google-signin-btn"
        class="w-full py-3 px-4 border border-gray-600 rounded-lg font-medium text-white hover:bg-gray-700 transition-colors flex items-center justify-center gap-2"
      >
        <svg class="w-5 h-5" viewBox="0 0 24 24">
          <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
          <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
          <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
          <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
        </svg>
        Войти через Google
      </button>
    </div>
  </div>
</div>

<script>
  import { signInWithEmail, signUpWithEmail, signInWithMagicLink, signInWithGoogle } from '../../lib/supabase';

  const modal = document.getElementById('auth-modal');
  const closeBtn = document.getElementById('close-auth-modal');
  const signinTab = document.getElementById('tab-signin');
  const signupTab = document.getElementById('tab-signup');
  const signinForm = document.getElementById('signin-form') as HTMLFormElement;
  const signupForm = document.getElementById('signup-form') as HTMLFormElement;
  const modalTitle = document.getElementById('auth-modal-title');
  const magicLinkBtn = document.getElementById('magic-link-btn');
  const googleSigninBtn = document.getElementById('google-signin-btn');

  // Open modal
  window.addEventListener('open-auth-modal', () => {
    modal?.classList.remove('hidden');
    modal?.classList.add('flex');
  });

  // Close modal
  closeBtn?.addEventListener('click', () => {
    modal?.classList.add('hidden');
    modal?.classList.remove('flex');
  });

  // Close on backdrop click
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }
  });

  // Tab switching
  signinTab?.addEventListener('click', () => {
    signinTab.classList.add('border-accent-blue', 'text-accent-blue');
    signinTab.classList.remove('border-transparent', 'text-gray-500');
    signupTab?.classList.remove('border-accent-blue', 'text-accent-blue');
    signupTab?.classList.add('border-transparent', 'text-gray-500');
    signinForm?.classList.remove('hidden');
    signupForm?.classList.add('hidden');
    if (modalTitle) modalTitle.textContent = 'Вход в аккаунт';
  });

  signupTab?.addEventListener('click', () => {
    signupTab.classList.add('border-accent-blue', 'text-accent-blue');
    signupTab.classList.remove('border-transparent', 'text-gray-500');
    signinTab?.classList.remove('border-accent-blue', 'text-accent-blue');
    signinTab?.classList.add('border-transparent', 'text-gray-500');
    signupForm?.classList.remove('hidden');
    signinForm?.classList.add('hidden');
    if (modalTitle) modalTitle.textContent = 'Регистрация';
  });

  // Sign in form
  signinForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = (document.getElementById('signin-email') as HTMLInputElement).value;
    const password = (document.getElementById('signin-password') as HTMLInputElement).value;
    const errorDiv = document.getElementById('signin-error');

    try {
      const response = await fetch('/api/auth/signin', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({ email, password }),
      });

      const data = await response.json();

      if (!response.ok) {
        errorDiv?.classList.remove('hidden');
        errorDiv!.textContent = data.error || 'Ошибка входа';
      } else {
        // Success - reload page
        window.location.reload();
      }
    } catch (error) {
      errorDiv?.classList.remove('hidden');
      errorDiv!.textContent = 'Произошла ошибка. Попробуйте снова.';
    }
  });

  // Sign up form
  signupForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const username = (document.getElementById('signup-username') as HTMLInputElement).value;
    const fullname = (document.getElementById('signup-fullname') as HTMLInputElement).value;
    const email = (document.getElementById('signup-email') as HTMLInputElement).value;
    const password = (document.getElementById('signup-password') as HTMLInputElement).value;
    const errorDiv = document.getElementById('signup-error');
    const successDiv = document.getElementById('signup-success');

    try {
      const response = await fetch('/api/auth/signup', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({ email, password, username, fullName: fullname }),
      });

      const data = await response.json();

      if (!response.ok) {
        errorDiv?.classList.remove('hidden');
        successDiv?.classList.add('hidden');
        errorDiv!.textContent = data.error || 'Ошибка регистрации';
      } else {
        errorDiv?.classList.add('hidden');
        successDiv?.classList.remove('hidden');
        successDiv!.textContent = data.message || 'Аккаунт создан! Проверьте email для подтверждения.';
        setTimeout(() => {
          // Switch to sign in tab
          signinTab?.click();
          successDiv?.classList.add('hidden');
        }, 3000);
      }
    } catch (error) {
      errorDiv?.classList.remove('hidden');
      successDiv?.classList.add('hidden');
      errorDiv!.textContent = 'Произошла ошибка. Попробуйте снова.';
    }
  });

  // Magic link
  magicLinkBtn?.addEventListener('click', async () => {
    const email = (document.getElementById('signin-email') as HTMLInputElement).value;
    if (!email) {
      alert('Пожалуйста, введите email');
      return;
    }

    try {
      const { error } = await signInWithMagicLink(email);
      if (error) {
        alert('Ошибка: ' + error.message);
      } else {
        alert('Magic link отправлен на ' + email + '. Проверьте почту!');
      }
    } catch (error) {
      alert('Произошла ошибка при отправке magic link');
    }
  });

  // Google OAuth
  googleSigninBtn?.addEventListener('click', async () => {
    try {
      const { error } = await signInWithGoogle();
      if (error) {
        alert('Ошибка: ' + error.message);
      }
      // OAuth will redirect automatically
    } catch (error) {
      alert('Произошла ошибка при входе через Google');
    }
  });
</script>

