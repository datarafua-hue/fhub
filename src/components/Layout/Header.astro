---
import MobileMenu from './MobileMenu.astro';
import MobileMenuButton from './MobileMenuButton.astro';
import AuthButton from '../Auth/AuthButton.astro';
import AuthModal from '../Auth/AuthModal.astro';
import AdminBadge from '../Admin/AdminBadge.astro';
import { getTranslations } from '../../i18n';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { getCollection } from 'astro:content';

interface Props {
	locale?: string;
}

const { locale } = Astro.props;
const currentLocale = locale || Astro.currentLocale || 'ru';
const t = getTranslations(currentLocale as 'ru' | 'en');
const otherLocale = currentLocale === 'ru' ? 'en' : 'ru';

// Получаем путь без префикса языка для правильной генерации URL
let currentPath = Astro.url.pathname;
// Убираем префикс /en или /ru если он есть
if (currentPath.startsWith('/en/')) {
	currentPath = currentPath.replace(/^\/en/, '');
} else if (currentPath.startsWith('/ru/')) {
	currentPath = currentPath.replace(/^\/ru/, '');
}
// Убеждаемся что путь начинается с /
if (!currentPath.startsWith('/')) {
	currentPath = '/' + currentPath;
}

// Функция для поиска соответствующего поста на другом языке
async function findCorrespondingPostUrl(path: string, targetLocale: string): Promise<string | null> {
	// Проверяем, является ли это страницей поста
	const postMatch = path.match(/^\/posts\/([^\/]+)\/([^\/]+)\/([^\/]+)/);
	if (!postMatch) {
		return null;
	}
	
	const [, category, subcategory, currentSlug] = postMatch;
	
	try {
		const allPosts = await getCollection('posts');
		
		// Извлекаем базовое имя из текущего slug (например, "post-1-ru" -> "post-1")
		const baseName = currentSlug.replace(/-(en|ru)$/, '');
		
		// Ищем пост с той же категорией, подкатегорией и базовым именем, но на другом языке
		const correspondingPost = allPosts.find(p => {
			if (p.data.lang !== targetLocale || p.data.category !== category || p.data.subcategory !== subcategory) {
				return false;
			}
			const pSlugParts = p.slug.split('/');
			const pFilename = pSlugParts[pSlugParts.length - 1];
			const pBaseName = pFilename.replace(/-(en|ru)$/, '');
			return pBaseName === baseName;
		});
		
		if (correspondingPost) {
			const slugParts = correspondingPost.slug.split('/');
			const filename = slugParts[slugParts.length - 1];
			// Генерируем правильный URL с учетом локали используя getRelativeLocaleUrl
			return getRelativeLocaleUrl(targetLocale, `posts/${category}/${subcategory}/${filename}`);
		}
	} catch (err) {
		// Если не удалось найти, возвращаем null
	}
	
	return null;
}

// Для страниц постов находим соответствующий пост на другом языке
let otherLocaleUrl: string | null = null;
if (currentPath.startsWith('/posts/')) {
	otherLocaleUrl = await findCorrespondingPostUrl(currentPath, otherLocale as 'ru' | 'en');
}
---

<!-- Desktop Header -->
<header class="hidden lg:flex fixed top-4 right-4 left-[17.5rem] z-40">
	<div class="flex items-center justify-between px-6 h-14 w-full">
		<div class="w-full flex items-center justify-between">
			<!-- Search Bar -->
			<div class="flex-1 max-w-xl">
			<div class="relative">
				<input
					type="search"
					placeholder={t.common.search}
					class="w-full px-4 py-2 pl-10 bg-white/5 rounded-full text-white placeholder-white/40 text-sm focus:outline-none focus:bg-white/8 transition-all border border-white/5"
				/>
				<svg class="absolute left-3.5 top-1/2 transform -translate-y-1/2 w-4 h-4 text-white/40" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
				</svg>
			</div>
		</div>

		<!-- Right side controls -->
		<div class="flex items-center gap-2 ml-6">
			{(() => {
				// Генерируем URL для каждого языка
				let ruUrl: string;
				let enUrl: string;
				
				if (otherLocaleUrl) {
					// Для страниц постов используем найденный URL соответствующего поста
					if (otherLocale === 'ru') {
						ruUrl = otherLocaleUrl;
						enUrl = '/en' + currentPath;
					} else {
						ruUrl = currentPath;
						enUrl = otherLocaleUrl;
					}
				} else {
					// Для остальных страниц генерируем URL вручную
					// Русский (default) = без префикса, Английский = /en
					ruUrl = currentPath;
					enUrl = '/en' + currentPath;
				}
				
				const languages = [
					{ code: 'ru', name: 'Русский', flag: '🇷🇺', url: ruUrl },
					{ code: 'en', name: 'English', flag: '🇬🇧', url: enUrl },
				];
				
				const currentLang = languages.find(l => l.code === currentLocale) || languages[0];
				
				return (
					<>
						<!-- Language Switcher Dropdown -->
						<div class="relative" id="language-switcher">
							<button
								type="button"
								class="flex items-center gap-2 px-3 py-1.5 bg-white/5 rounded-full hover:bg-white/8 transition-all text-sm language-switcher-button border border-white/5"
								aria-label="Select language"
								aria-expanded="false"
								aria-haspopup="true"
							>
								<span class="text-base">{currentLang.flag}</span>
								<span class="text-white/70 font-medium text-xs">{currentLang.code.toUpperCase()}</span>
								<svg class="w-3 h-3 text-white/40 transition-transform" fill="currentColor" viewBox="0 0 24 24">
									<path d="M7.41 8.59L12 13.17l4.59-4.58L18 10l-6 6-6-6 1.41-1.41z" />
								</svg>
							</button>
							
							<!-- Dropdown Menu -->
							<div class="absolute right-0 mt-2 w-44 rounded-2xl shadow-2xl opacity-0 invisible transform translate-y-2 transition-all duration-300 z-50 language-dropdown border border-white/8" style="background: rgba(20, 20, 25, 0.9); backdrop-filter: blur(60px); -webkit-backdrop-filter: blur(60px);">
								<div class="py-2">
									{languages.map((language) => (
										<a
											href={language.url}
											class={`flex items-center gap-3 px-3 py-2 text-sm transition-all rounded-xl mx-2 ${
												language.code === currentLocale
													? 'bg-white/12 text-white font-medium'
													: 'text-white/70 hover:bg-white/6 hover:text-white'
											}`}
										>
											<span class="text-base">{language.flag}</span>
											<span class="text-xs">{language.name}</span>
											{language.code === currentLocale && (
												<svg class="w-3.5 h-3.5 ml-auto" fill="currentColor" viewBox="0 0 20 20">
													<path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
												</svg>
											)}
										</a>
									))}
								</div>
							</div>
						</div>

						<!-- Icon Buttons -->
						<button
							class="p-2 bg-white/5 rounded-full hover:bg-white/8 transition-all border border-white/5"
							aria-label="Share"
						>
							<svg class="w-4 h-4 text-white/60" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" />
							</svg>
						</button>

						<button
							class="p-2 bg-white/5 rounded-full hover:bg-white/8 transition-all border border-white/5"
							aria-label="Favorites"
						>
							<svg class="w-4 h-4 text-white/60" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
							</svg>
						</button>

						<button
							class="p-2 bg-white/5 rounded-full hover:bg-white/8 transition-all border border-white/5"
							aria-label="Collections"
						>
							<svg class="w-4 h-4 text-white/60" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
							</svg>
						</button>

						<button
							class="p-2 bg-white/5 rounded-full hover:bg-white/8 transition-all border border-white/5"
							aria-label="Info"
						>
							<svg class="w-4 h-4 text-white/60" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
							</svg>
						</button>

						<!-- Admin Badge -->
						<AdminBadge />

						<!-- Auth Button -->
						<div class="ml-2 pl-2 border-l border-white/10">
							<AuthButton />
						</div>
					</>
				);
			})()}
			</div>
		</div>
	</div>
</header>

<MobileMenu locale={currentLocale} />
<MobileMenuButton locale={currentLocale} />

<!-- Auth Modal (global) -->
<AuthModal />

<script>
	const themeToggle = document.getElementById('theme-toggle');
	const sunIcon = document.getElementById('sun-icon');
	const moonIcon = document.getElementById('moon-icon');

	themeToggle?.addEventListener('click', () => {
		const html = document.documentElement;
		const isDark = html.classList.contains('dark');
		
		if (isDark) {
			html.classList.remove('dark');
			localStorage.theme = 'light';
		} else {
			html.classList.add('dark');
			localStorage.theme = 'dark';
		}
	});
	
	// Language switcher dropdown
	document.addEventListener('DOMContentLoaded', () => {
		const languageSwitcher = document.getElementById('language-switcher');
		const button = languageSwitcher?.querySelector('.language-switcher-button');
		const dropdown = languageSwitcher?.querySelector('.language-dropdown');
		
		if (!button || !dropdown) return;
		
		// Toggle dropdown
		button.addEventListener('click', (e) => {
			e.stopPropagation();
			const isOpen = dropdown.classList.contains('opacity-100');
			
			if (isOpen) {
				dropdown.classList.remove('opacity-100', 'visible', 'translate-y-0');
				dropdown.classList.add('opacity-0', 'invisible', 'translate-y-2');
				button.setAttribute('aria-expanded', 'false');
				button.querySelector('svg')?.classList.remove('rotate-180');
			} else {
				dropdown.classList.remove('opacity-0', 'invisible', 'translate-y-2');
				dropdown.classList.add('opacity-100', 'visible', 'translate-y-0');
				button.setAttribute('aria-expanded', 'true');
				button.querySelector('svg')?.classList.add('rotate-180');
			}
		});
		
		// Close dropdown when clicking outside
		document.addEventListener('click', (e) => {
			if (!languageSwitcher?.contains(e.target as Node)) {
				dropdown.classList.remove('opacity-100', 'visible', 'translate-y-0');
				dropdown.classList.add('opacity-0', 'invisible', 'translate-y-2');
				button.setAttribute('aria-expanded', 'false');
				button.querySelector('svg')?.classList.remove('rotate-180');
			}
		});
	});
</script>

<style>
	.language-dropdown {
		min-width: 12rem;
	}
	
	.language-switcher-button svg {
		transition: transform 0.2s ease;
	}
	
	.language-switcher-button[aria-expanded="true"] svg {
		transform: rotate(180deg);
	}
	
	.mobile-language-dropdown {
		min-width: 100%;
	}
	
	.mobile-language-switcher-button svg {
		transition: transform 0.2s ease;
	}
	
	.mobile-language-switcher-button[aria-expanded="true"] svg {
		transform: rotate(180deg);
	}

	/* Center header on large screens */
	@media (min-width: 1440px) {
		header {
			left: calc((100vw - 1440px) / 2 + 17.5rem);
			right: calc((100vw - 1440px) / 2 + 1rem);
		}
	}
</style>

