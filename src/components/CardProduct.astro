---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { getTranslations } from '../i18n';

interface Props {
	title: string;
	price: string;
	oldPrice?: string | null;
	inStock: boolean;
	badge?: string | null;
	image?: string;
	slug: string;
	locale?: string;
}

const { title, price, oldPrice, inStock, badge = inStock ? 'stock' : undefined, image = '/favicon.svg', slug, locale } = Astro.props;

const currentLocale = locale || Astro.currentLocale || 'ru';
const t = getTranslations(currentLocale as 'ru' | 'en');

const badgeConfig: Record<string, { text: string; class: string }> = {
	stock: { text: t.product.inStock, class: 'bg-green-500/20 text-green-400 border-green-500/50 backdrop-blur-sm' },
	ad: { text: 'AD', class: 'bg-red-500/20 text-red-400 border-red-500/50 backdrop-blur-sm' },
	dev: { text: 'DEV MODE', class: 'bg-yellow-500/20 text-yellow-400 border-yellow-500/50 backdrop-blur-sm' },
	'Популярное': { text: t.product.popular, class: 'bg-blue-500/20 text-blue-400 border-blue-500/50 backdrop-blur-sm' },
	popular: { text: t.product.popular, class: 'bg-blue-500/20 text-blue-400 border-blue-500/50 backdrop-blur-sm' },
	'Скидка': { text: t.product.sale, class: 'bg-orange-500/20 text-orange-400 border-orange-500/50 backdrop-blur-sm' },
	sale: { text: t.product.sale, class: 'bg-orange-500/20 text-orange-400 border-orange-500/50 backdrop-blur-sm' },
};
---

<article class="glass-card rounded-2xl overflow-hidden hover:scale-[1.02] hover:shadow-glass-lg transition-all cursor-pointer group relative backdrop-blur-glass">
	<a href={getRelativeLocaleUrl(currentLocale, `products/${slug}`)} class="block">
		<div class="relative h-48 bg-dark overflow-hidden rounded-t-2xl">
			<div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent z-10"></div>
			{badge && badgeConfig[badge] && (
				<div class={`absolute top-3 left-3 px-2.5 py-1 text-xs font-bold rounded-lg border z-20 ${badgeConfig[badge].class}`}>
					{badgeConfig[badge].text}
				</div>
			)}
			{badge === 'dev' && (
				<div class="absolute bottom-3 right-3 px-2.5 py-1 text-xs font-bold rounded-lg bg-yellow-500/20 text-yellow-400 border border-yellow-500/50 z-20 backdrop-blur-sm">
					DEV MODE
				</div>
			)}
			<img src={image} alt={title} class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" />
		</div>

		<div class="p-4 lg:p-6">
			<h3 class="text-base lg:text-lg font-semibold mb-3 text-white group-hover:text-gradient-blue transition-all line-clamp-2 leading-tight">
				{title}
			</h3>

			<div class="flex items-baseline gap-2 flex-wrap">
				<span class="text-xl lg:text-2xl font-bold text-white">
					{price}
				</span>
				{oldPrice && (
					<span class="text-xs lg:text-sm text-gray-500 line-through">
						{oldPrice}
					</span>
				)}
			</div>
		</div>
	</a>
</article>
